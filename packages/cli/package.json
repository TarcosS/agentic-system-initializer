{
  "name": "@deopca/agentinit",
  "version": "0.1.0",
  "description": "CLI tool to initialize AI coding agent configurations — compiles agentic-system-initializer.md into targeted, user-profiled scaffolds",
  "type": "module",
  "bin": {
    "agentinit": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && rm -rf dist/rules dist/templates && mkdir -p dist/rules && cp -r src/rules/builtin dist/rules/builtin && cp -r src/templates dist/templates",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run build",
    "split": "npx tsx ../../scripts/split-sections.ts ../..",
    "version:patch": "cd ../.. && ./scripts/release.sh patch",
    "version:minor": "cd ../.. && ./scripts/release.sh minor",
    "version:major": "cd ../.. && ./scripts/release.sh major"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "cursor",
    "copilot",
    "codex",
    "scaffold",
    "initializer",
    "developer-tools"
  ],
  "author": "DEOPCA",
  "license": "SEE LICENSE IN ../../LICENSE",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src/templates",
    "src/rules/builtin",
    "templates"
  ],
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.13.0",
    "eslint": "^9.19.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.0.0"
  }
}
